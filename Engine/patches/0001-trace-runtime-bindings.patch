diff --git a/src/core/ScadrettoTrace.cc b/src/core/ScadrettoTrace.cc
new file mode 100644
index 0000000..b029e03
--- /dev/null
+++ b/src/core/ScadrettoTrace.cc
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "core/ScadrettoTrace.h"
+
+#include <cmath>
+#include <fstream>
+#include <iomanip>
+#include <iterator>
+#include <map>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+#include <openssl/sha.h>
+
+#include "core/Assignment.h"
+#include "core/BuiltinContext.h"
+#include "core/Context.h"
+#include "core/EvaluationSession.h"
+#include "core/ModuleInstantiation.h"
+#include "core/RenderVariables.h"
+#include "core/SourceFile.h"
+#include "core/TransformNode.h"
+#include "core/Tree.h"
+#include "core/Value.h"
+#include "core/parsersettings.h"
+#include "ext/json/json.hpp"
+#include "geometry/GeometryEvaluator.h"
+#include "geometry/PolySet.h"
+#include "geometry/PolySetUtils.h"
+#include "openscad.h"
+#include "utils/printutils.h"
+
+using nlohmann::json;
+
+namespace {
+bool traceEnabled = false;
+constexpr auto maxSourceBytes = 16 * 1024 * 1024;
+constexpr auto maxRequestBytes = 64 * 1024;
+constexpr auto maxMessages = 256;
+constexpr auto maxMessageBytes = 4096;
+
+std::string readFile(const fs::path& path, std::size_t limit)
+{
+  auto length = fs::file_size(path);
+  if (length > limit) throw std::runtime_error("Job input exceeds size limit");
+  std::ifstream stream(path, std::ios::binary);
+  std::string contents(length, '\0');
+  if (!stream.read(contents.data(), length) || stream.peek() != EOF) {
+    throw std::runtime_error("Cannot read job input");
+  }
+  return contents;
+}
+
+std::string digest(const std::string& text)
+{
+  unsigned char bytes[SHA256_DIGEST_LENGTH];
+  SHA256(reinterpret_cast<const unsigned char *>(text.data()), text.size(), bytes);
+  std::ostringstream hex;
+  for (auto byte : bytes) hex << std::hex << std::setw(2) << std::setfill('0') << unsigned(byte);
+  return hex.str();
+}
+
+struct MainSource {
+  fs::path logicalPath;
+  std::string bytes;
+  std::size_t bomBytes;
+  std::vector<std::size_t> lines;
+
+  MainSource(fs::path path, std::string bytes)
+    : logicalPath(std::move(path)), bytes(std::move(bytes)),
+      bomBytes(this->bytes.rfind("\xef\xbb\xbf", 0) == 0 ? 3 : 0), lines{0}
+  {
+    for (std::size_t i = 0; i < this->bytes.size(); ++i) {
+      if (this->bytes[i] == '\n') lines.push_back(i + 1);
+    }
+  }
+
+  json span(const Location& loc) const
+  {
+    // The pin's lexer reports one-based byte columns and exclusive end locations.
+    if (loc.isNone() || loc.filePath() != logicalPath) return nullptr;
+    const auto offset = [this](int line, int column) {
+      if (line < 1 || column < 1 || std::size_t(line) > lines.size()) {
+        throw std::out_of_range("source location");
+      }
+      auto start = lines[line - 1];
+      auto end = std::size_t(line) < lines.size() ? lines[line] : bytes.size();
+      if (std::size_t(column - 1) > end - start) throw std::out_of_range("source column");
+      return start + std::size_t(column - 1);
+    };
+    try {
+      auto start = offset(loc.firstLine(), loc.firstColumn());
+      auto end = offset(loc.lastLine(), loc.lastColumn());
+      if (start <= end) return {{"file", logicalPath.string()}, {"start", start}, {"end", end}};
+    } catch (const std::out_of_range&) {
+      // No span for parser locations in the synthetic end-of-input newline.
+    }
+    return nullptr;
+  }
+};
+
+json packMesh(const std::shared_ptr<const Geometry>& geometry)
+{
+  json vertices = json::array();
+  json triangles = json::array();
+  const auto polygonMesh = PolySetUtils::getGeometryAsPolySet(geometry);
+  if (polygonMesh && !polygonMesh->isEmpty()) {
+    auto triangulation = !polygonMesh->isTriangular() ? PolySetUtils::tessellate_faces(*polygonMesh)
+                                                      : nullptr;
+    const auto& mesh = triangulation ? *triangulation : *polygonMesh;
+    for (const auto& v : mesh.vertices) vertices.push_back({v.x(), v.y(), v.z()});
+    for (const auto& face : mesh.indices) {
+      if (face.size() != 3) throw std::runtime_error("Expected a triangulated mesh");
+      triangles.push_back({face[0], face[1], face[2]});
+    }
+  }
+  return {{"vertices", std::move(vertices)}, {"triangles", std::move(triangles)}};
+}
+
+json matrix(const Transform3d& transform)
+{
+  const auto& values = transform.matrix();
+  return std::vector<double>(values.data(), values.data() + 16);
+}
+
+struct SceneTrace {
+  const MainSource& source;
+  const Tree& tree;
+  GeometryEvaluator& evaluator;
+  json instances = json::array();
+  json operands = json::array();
+  // Tree's geometry cache key is independent of occurrence identity and source binding.
+  std::map<std::string, std::size_t> operandIDs;
+
+  void visit(const AbstractNode& node, json parent, const Transform3d& parentWorld,
+             std::map<std::string, double> iteration)
+  {
+    if (node.modinst && node.modinst->isBackground()) return;
+    for (const auto& [name, value] : node.scadrettoIteration) iteration[name] = value;
+    Transform3d local = Transform3d::Identity();
+    if (auto transform = dynamic_cast<const TransformNode *>(&node)) local = transform->matrix;
+    Transform3d world = parentWorld * local;
+    json operand;
+    if (dynamic_cast<const LeafNode *>(&node)) {
+      auto key = tree.getIdString(node);
+      if (auto entry = operandIDs.find(key); entry != operandIDs.end()) {
+        operand = entry->second;
+      } else {
+        auto geometry = evaluator.evaluateGeometry(node, true);
+        if (geometry && geometry->getDimension() == 3 && !geometry->isEmpty()) {
+          auto id = operands.size();
+          operands.push_back(packMesh(geometry));
+          operandIDs.emplace(std::move(key), id);
+          operand = id;
+        }
+      }
+    }
+
+    json diameter;
+    if (node.scadrettoDiameter) {
+      json chain = json::array();
+      for (auto binding = node.scadrettoDiameter; binding; binding = binding->previous) {
+        chain.push_back({{"kind", binding->kind}, {"name", binding->name},
+                         {"span", source.span(binding->location)}});
+      }
+      diameter = {{"value", node.scadrettoDiameterValue}, {"chain", std::move(chain)}};
+    }
+    instances.push_back({{"id", node.index()}, {"parent", parent},
+                         {"name", node.modinst ? node.modinst->name() : node.name()},
+                         {"span", node.modinst ? source.span(node.modinst->location()) : json(nullptr)},
+                         {"iteration", iteration}, {"local", matrix(local)}, {"world", matrix(world)},
+                         {"operand", operand}, {"diameter", diameter}});
+    for (const auto& child : node.children) visit(*child, node.index(), world, iteration);
+  }
+};
+
+void writeResult(const fs::path& directory, const json& result)
+{
+  const auto partial = directory / "result.tmp";
+  std::ofstream output(partial, std::ios::binary | std::ios::trunc);
+  output.exceptions(std::ios::badbit | std::ios::failbit);
+  output << result.dump(-1, ' ', false, json::error_handler_t::replace) << '\n';
+  output.close();
+  fs::rename(partial, directory / "result.json");
+}
+}  // namespace
+
+void scadrettoMark(Value& value, const std::string& kind, const std::string& name,
+                   const Location& location)
+{
+  if (!traceEnabled || value.type() != Value::Type::NUMBER) return;
+  value.scadrettoBinding = std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{kind, name, location, value.scadrettoBinding});
+}
+
+void scadrettoRecordIteration(AbstractNode& loop, std::size_t firstChild,
+                              const std::vector<std::shared_ptr<Assignment>>& arguments,
+                              const std::shared_ptr<const Context>& iterationContext)
+{
+  if (!traceEnabled || firstChild == loop.children.size()) return;
+  std::map<std::string, double> bindings;
+  for (const auto& arg : arguments) {
+    const auto& name = arg->getName();
+    const auto& value = iterationContext->lookup_variable(name, arg->location());
+    if (value.type() == Value::Type::NUMBER) bindings[name] = value.toDouble();
+  }
+  for (auto i = firstChild; i < loop.children.size(); ++i) {
+    loop.children[i]->scadrettoIteration = bindings;
+  }
+}
+
+int scadrettoRunJob(const std::string& requestPath)
+{
+  const auto directory = fs::absolute(requestPath).parent_path();
+  json result = {{"status", "error"}};
+  json console = json::array();
+  set_output_handler([](const Message& message, void *data) {
+    auto& capture = *static_cast<json *>(data);
+    if (capture.size() < maxMessages) {
+      capture.push_back(message.str().substr(0, maxMessageBytes));
+    }
+  }, nullptr, &console);
+
+  try {
+    const auto request = json::parse(readFile(requestPath, maxRequestBytes));
+    fs::path logicalPath(request.at("logicalPath").get<std::string>());
+    if (!logicalPath.is_absolute() || request.at("snapshot") != "main.scad") {
+      throw std::runtime_error("Job needs an absolute logical source path and main.scad snapshot");
+    }
+    MainSource source(logicalPath, readFile(directory / "main.scad", maxSourceBytes));
+    result["sourceByteLength"] = source.bytes.size();
+    result["sourceSHA256"] = digest(source.bytes);
+    result["bomBytes"] = source.bomBytes;
+
+    traceEnabled = true;
+    const auto constructionDirectory = logicalPath.parent_path();
+    EvaluationSession session(constructionDirectory.string());
+    ContextHandle<BuiltinContext> builtins{Context::create<BuiltinContext>(&session)};
+    RenderVariables{.preview = false, .time = 0, .camera = Camera{}}.applyToContext(builtins);
+    // The spike resolves sibling inputs and uses only explicit resource roots.
+    for (const auto& library : request.value("libraryRoots", std::vector<std::string>{})) {
+      if (!fs::path(library).is_absolute()) throw std::runtime_error("Library root must be absolute");
+      add_librarydir(library);
+    }
+    fs::current_path(constructionDirectory);
+    SourceFile *parsed = nullptr;
+    const auto path = logicalPath.string();
+    const auto ok = parse(parsed, source.bytes + "\n", path, path, false);
+    std::unique_ptr<SourceFile> file(parsed);
+    if (!ok || !file) throw std::runtime_error("Could not parse source snapshot");
+    file->handleDependencies();
+
+    AbstractNode::resetIndexCounter();
+    std::shared_ptr<const FileContext> fileContext;
+    auto absoluteRoot = file->instantiate(*builtins, &fileContext);
+    auto root = find_root_tag(absoluteRoot);
+    if (!root) root = absoluteRoot;
+
+    Tree tree(root, constructionDirectory.string());
+    GeometryEvaluator evaluator(tree);
+    const auto geometry = evaluator.evaluateGeometry(*root, true);
+    if (geometry && geometry->getDimension() != 3 && !geometry->isEmpty()) {
+      throw std::runtime_error("Top-level geometry is not three-dimensional");
+    }
+    result["mesh"] = packMesh(geometry);
+    SceneTrace trace{source, tree, evaluator};
+    trace.visit(*root, nullptr, Transform3d::Identity(), {});
+    result["instances"] = std::move(trace.instances);
+    result["operands"] = std::move(trace.operands);
+    result["status"] = "ok";
+  } catch (const std::exception& error) {
+    result["error"] = error.what();
+  }
+
+  traceEnabled = false;
+  set_output_handler(nullptr, nullptr, nullptr);
+  result["console"] = std::move(console);
+  try {
+    writeResult(directory, result);
+  } catch (const std::exception& error) {
+    LOG(message_group::Error, "Could not write Scadretto job result: %1$s", error.what());
+    return 2;
+  }
+  return result["status"] == "ok" ? 0 : 1;
+}
