+    if (!logicalPath.is_absolute() || request.at("snapshot") != "main.scad") {
+      throw std::runtime_error("Job needs an absolute logical source path and main.scad snapshot");
+    }
+    std::string untitledBase;
+    if (request.contains("untitledBaseDirectory") &&
+        !request.at("untitledBaseDirectory").is_null()) {
+      untitledBase = stringField(request, "untitledBaseDirectory");
+      if (!fs::path(untitledBase).is_absolute()) {
+        throw std::runtime_error("Job untitledBaseDirectory must be absolute");
+      }
+    }
+    const auto libraryRoots = stringArray(request, "libraryRoots");
+    const auto resourceRoots = stringArray(request, "resourceRoots");
+    const auto backend = stringField(request, "backend");
+    if (backend != "manifold" || !request.at("preview").is_boolean() ||
+        request.at("preview").get<bool>()) {
+      throw std::runtime_error("Job needs backend manifold and preview false");
+    }
+    const auto expectedBuild = stringField(request, "expectedWorkerBuild");
+    if (key.at("workerBuild") != expectedBuild) {
+      throw std::runtime_error("Job key workerBuild does not match expectedWorkerBuild");
+    }
+    if (result["buildSHA"] != expectedBuild) {
+      return fail("buildMismatch", "Worker executable digest does not match expectedWorkerBuild");
+    }
+
+    std::vector<std::string> resolution{"resolution-v1", logicalPathString, untitledBase,
+                                        std::to_string(libraryRoots.size())};
+    resolution.insert(resolution.end(), libraryRoots.begin(), libraryRoots.end());
+    resolution.push_back(std::to_string(resourceRoots.size()));
+    resolution.insert(resolution.end(), resourceRoots.begin(), resourceRoots.end());
+    if (contextDigest(resolution) != key.at("resolutionDigest").get<std::string>()) {
+      throw std::runtime_error("Job resolutionDigest does not match request fields");
+    }
+    if (contextDigest({"options-v1", backend, "false"}) != key.at("optionsDigest").get<std::string>()) {
+      throw std::runtime_error("Job optionsDigest does not match request fields");
+    }
+
+    const auto& source = mainSource.emplace(logicalPath, readFile(directory / "main.scad", maxSourceBytes));
+    const auto sourceSHA = digest(source.bytes);
+    if (sourceSHA != stringField(request, "sourceSHA256")) {
+      throw std::runtime_error("Job sourceSHA256 does not match main.scad snapshot");
+    }
+    result["files"] = {{{"id", mainFileID},
+                        {"logicalPath", logicalPathString},
+                        {"sha256", sourceSHA},
+                        {"byteLength", source.bytes.size()},
+                        {"kind", "main"},
+                        {"writable", true}}};
+
+    scadretto::beginDependencies();
+    traceEnabled = true;
+    if (!resourceRoots.empty()) {
+      const auto fontConfig = fs::path(resourceRoots.front()) / "fonts" / "fonts.conf";
+      ::setenv("FONTCONFIG_FILE", fontConfig.c_str(), 1);
+    }
+    const auto constructionDirectory =
+      untitledBase.empty() ? logicalPath.parent_path() : fs::path(untitledBase);
+    EvaluationSession session(constructionDirectory.string());
+    ContextHandle<BuiltinContext> builtins{Context::create<BuiltinContext>(&session)};
+    RenderVariables{.preview = false, .time = 0, .camera = Camera{}}.applyToContext(builtins);
+    for (const auto& library : libraryRoots) add_librarydir(library);
+    fs::current_path(constructionDirectory);
+
+    MeshPayload meshPayload(directory / "mesh.bin", "mesh.bin");
+    MeshPayload operandPayload(directory / "operands.bin", "operands.bin");
+
+    SourceFile *parsed = nullptr;
+    const auto path = logicalPath.string();
+    std::unique_ptr<SourceFile> file;
+    try {
+      const auto ok = parse(parsed, source.bytes + "\n", path, path, false);
+      file.reset(parsed);
+      if (!ok || !file) throw std::runtime_error("Could not parse source snapshot");
+      file->handleDependencies();
+
+      AbstractNode::resetIndexCounter();
+      std::shared_ptr<const FileContext> fileContext;
+      auto absoluteRoot = file->instantiate(*builtins, &fileContext);
+      auto root = find_root_tag(absoluteRoot);
+      if (!root) root = absoluteRoot;
+
+      Tree tree(root, constructionDirectory.string());
+      GeometryEvaluator evaluator(tree);
+      const auto geometry = evaluator.evaluateGeometry(*root, true);
+      if (geometry && geometry->getDimension() != 3 && !geometry->isEmpty()) {
+        return fail("unsupportedDimension", "Top-level geometry is not three-dimensional");
+      }
+      json mesh = geometry && !geometry->isEmpty() ? meshPayload.append(geometry) : json(nullptr);
+      SceneTrace trace{source, tree, evaluator, &operandPayload};
+      trace.visit(*root, nullptr, Transform3d::Identity(), {});
+      result["mesh"] = std::move(mesh);
+      result["instances"] = std::move(trace.instances);
+      result["operands"] = std::move(trace.operands);
+      result["operations"] = std::move(trace.operations);
+      result["dependencyEdges"] = std::move(trace.dependencyEdges);
+      result["detail"] = result["mesh"].is_null() ? "empty" : "rendered";
+      result["status"] = "ok";
+    } catch (const std::ios_base::failure& error) {
+      return fail("internalError", error.what());
+    } catch (const std::exception& error) {
+      return fail("modelError", error.what());
+    }
+  } catch (const std::ios_base::failure& error) {
+    return fail("internalError", error.what());
+  } catch (const std::exception& error) {
+    return fail("protocolMismatch", error.what());
+  }
+
+  return finish();
+}
