diff --git a/src/core/ScadrettoDependencies.cc b/src/core/ScadrettoDependencies.cc
new file mode 100644
index 0000000..d95382b
--- /dev/null
+++ b/src/core/ScadrettoDependencies.cc
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "core/ScadrettoDependencies.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <mutex>
+#include <unordered_map>
+#include <utility>
+
+#include <openssl/evp.h>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
+
+#include "io/fileutils.h"
+
+using nlohmann::json;
+
+namespace {
+
+constexpr std::size_t maxDependencyFiles = 2048;
+constexpr std::size_t maxDependencyLookups = 4096;
+constexpr std::size_t maxLookupCandidates = 256;
+constexpr std::size_t maxPathBytes = 4096;
+constexpr std::size_t maxNameBytes = 1024;
+// Files larger than this keep a record but get no digest or span index.
+constexpr std::uintmax_t maxDigestBytes = 512ULL * 1024 * 1024;
+// Line indices are capped so span lookups stay bounded in memory.
+constexpr std::size_t maxIndexedLines = 2'000'000;
+
+struct DependencyFile {
+  std::string logicalPath;
+  std::string resolvedPath;  // empty while the file is not on disk
+  std::string sha256;        // empty when bytes are unknown
+  std::uint64_t byteLength = 0;
+  bool hasBytes = false;
+  std::string kind;
+  std::vector<std::uint64_t> lineStarts;  // empty => no span index
+};
+
+struct DependencyLookup {
+  std::string requestingPath;
+  std::string name;
+  std::vector<std::string> candidates;
+  std::string winner;
+};
+
+bool enabled = false;
+std::mutex dependenciesMutex;
+std::vector<DependencyFile> trackedFiles;
+std::unordered_map<std::string, std::size_t> trackedFileKeys;
+std::vector<DependencyLookup> trackedLookups;
+std::size_t droppedFiles = 0;
+std::size_t droppedLookups = 0;
+
+std::string bounded(const std::string& value, std::size_t limit)
+{
+  return value.size() <= limit ? value : value.substr(0, limit);
+}
+
+std::string boundedPath(const std::string& path)
+{
+  return bounded(path, maxPathBytes);
+}
+
+std::string pathKey(const fs::path& path)
+{
+  std::error_code error;
+  const fs::path canonical = fs::weakly_canonical(path, error);
+  const fs::path& normalized = error ? path.lexically_normal() : canonical;
+  return normalized.generic_string();
+}
+
+const char *kindName(scadretto::DependencyKind kind)
+{
+  switch (kind) {
+  case scadretto::DependencyKind::Main:     return "main";
+  case scadretto::DependencyKind::Include:  return "include";
+  case scadretto::DependencyKind::Use:      return "use";
+  case scadretto::DependencyKind::Import:   return "import";
+  case scadretto::DependencyKind::Surface:  return "surface";
+  case scadretto::DependencyKind::Dxf:      return "dxf";
+  case scadretto::DependencyKind::Font:     return "font";
+  }
+  return "unknown";
+}
+
+constexpr std::size_t sha256Bytes = 32;
+
+std::string hexDigest(const unsigned char *digest)
+{
+  static const char hex[] = "0123456789abcdef";
+  std::string out(2 * sha256Bytes, '0');
+  for (std::size_t i = 0; i < sha256Bytes; ++i) {
+    out[2 * i] = hex[digest[i] >> 4];
+    out[2 * i + 1] = hex[digest[i] & 0xf];
+  }
+  return out;
+}
+
+struct Sha256 {
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  ~Sha256() { EVP_MD_CTX_free(context); }
+  Sha256() { EVP_DigestInit_ex(context, EVP_sha256(), nullptr); }
+  void update(const char *data, std::size_t size) { EVP_DigestUpdate(context, data, size); }
+  std::string final()
+  {
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int size = 0;
+    EVP_DigestFinal_ex(context, digest, &size);
+    return hexDigest(digest);
+  }
+};
+
+// Byte offsets of each line start in the raw file bytes, including a BOM.
+// The pin's lexer reports one-based byte columns, so no decoding is needed.
+struct SpanIndex {
+  std::vector<std::uint64_t> lineStarts{0};
+  bool complete = true;
+  std::uint64_t consumed = 0;
+
+  void feed(const char *data, std::size_t size)
+  {
+    if (!complete) return;
+    for (std::size_t i = 0; i < size; ++i) {
+      if (data[i] == '\n') lineStarts.push_back(consumed + i + 1);
+    }
+    consumed += size;
+    if (lineStarts.size() > maxIndexedLines) {
+      lineStarts.clear();
+      complete = false;
+    }
+  }
+};
+
+// Streams a file for its digest and span index. Reads every readable byte so
+// the digest covers the file the parser saw, BOM included.
+void digestOnDisk(DependencyFile& record, const fs::path& path)
+{
+  std::error_code error;
+  const auto size = fs::file_size(path, error);
+  if (error || size > maxDigestBytes) return;
+  std::ifstream stream(path, std::ios::binary);
+  if (!stream) return;
+
+  Sha256 sha;
+  SpanIndex index;
+  std::uint64_t remaining = size;
+  std::vector<char> chunk(std::min<std::uint64_t>(size, 1 << 20));
+  while (remaining > 0 && stream) {
+    const auto count = static_cast<std::size_t>(
+      std::min<std::uint64_t>(remaining, chunk.size()));
+    stream.read(chunk.data(), count);
+    const auto got = static_cast<std::size_t>(stream.gcount());
+    if (got == 0) break;
+    sha.update(chunk.data(), got);
+    index.feed(chunk.data(), got);
+    remaining -= got;
+  }
+  if (remaining != 0) return;  // truncated or unreadable: no digest
+
+  record.sha256 = sha.final();
+  record.byteLength = size;
+  record.hasBytes = true;
+  if (index.complete) record.lineStarts = std::move(index.lineStarts);
+}
+
+void digestBuffer(DependencyFile& record, const std::string& bytes)
+{
+  if (bytes.size() > maxDigestBytes) return;
+  Sha256 sha;
+  sha.update(bytes.data(), bytes.size());
+  SpanIndex index;
+  index.feed(bytes.data(), bytes.size());
+  record.sha256 = sha.final();
+  record.byteLength = bytes.size();
+  record.hasBytes = true;
+  if (index.complete) record.lineStarts = std::move(index.lineStarts);
+}
+
+void resolveOnDisk(DependencyFile& record, std::size_t id, const fs::path& path)
+{
+  std::error_code error;
+  if (!fs::exists(path, error) || error) return;
+  const fs::path canonical = fs::canonical(path, error);
+  if (error) return;
+  record.resolvedPath = boundedPath(fs_generic_string(canonical));
+  trackedFileKeys[canonical.generic_string()] = id;
+}
+
+DependencyFile& fileRecord(const std::string& path, scadretto::DependencyKind kind)
+{
+  const std::string key = pathKey(fs::path(path));
+  if (const auto found = trackedFileKeys.find(key); found != trackedFileKeys.end()) {
+    auto& record = trackedFiles[found->second];
+    if (record.resolvedPath.empty()) resolveOnDisk(record, found->second, fs::path(path));
+    return record;
+  }
+  if (trackedFiles.size() >= maxDependencyFiles) {
+    ++droppedFiles;
+    // Records past the bound share a slot that is never serialized.
+    static DependencyFile overflow;
+    return overflow;
+  }
+  const auto id = trackedFiles.size();
+  auto& record = trackedFiles.emplace_back();
+  trackedFileKeys.emplace(key, id);
+  record.logicalPath = boundedPath(fs::path(path).generic_string());
+  record.kind = kindName(kind);
+  resolveOnDisk(record, id, fs::path(path));
+  return record;
+}
+
+constexpr std::size_t npos = std::string::npos;
+
+std::size_t lookupFileIndex(const std::string& path)
+{
+  const auto found = trackedFileKeys.find(pathKey(fs::path(path)));
+  return found == trackedFileKeys.end() ? npos : found->second;
+}
+
+json offsets(const DependencyFile& record, const Location& location)
+{
+  const auto offset = [&record](int line, int column, std::uint64_t& out) {
+    if (line < 1 || column < 1 || static_cast<std::uint64_t>(line) > record.lineStarts.size()) {
+      return false;
+    }
+    const auto start = record.lineStarts[line - 1];
+    const auto end = static_cast<std::uint64_t>(line) < record.lineStarts.size()
+                       ? record.lineStarts[line]
+                       : record.byteLength;
+    if (static_cast<std::uint64_t>(column - 1) > end - start) return false;
+    out = start + static_cast<std::uint64_t>(column - 1);
+    return true;
+  };
+  std::uint64_t start, end;
+  if (!offset(location.firstLine(), location.firstColumn(), start) ||
+      !offset(location.lastLine(), location.lastColumn(), end) || start > end) {
+    return nullptr;
+  }
+  return {{"start", start}, {"end", end}};
+}
+
+}  // namespace
+
+namespace scadretto {
+
+void beginDependencies()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  trackedFiles.clear();
+  trackedFileKeys.clear();
+  trackedLookups.clear();
+  droppedFiles = 0;
+  droppedLookups = 0;
+  enabled = true;
+}
+
+void endDependencies()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  enabled = false;
+}
+
+bool dependenciesEnabled()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  return enabled;
+}
+
+void observeFile(const std::string& path, DependencyKind kind)
+{
+  if (path.empty()) return;
+  try {
+    const std::lock_guard<std::mutex> lock(dependenciesMutex);
+    if (!enabled) return;
+    auto& record = fileRecord(path, kind);
+    if (record.resolvedPath.empty() || record.hasBytes) return;
+    digestOnDisk(record, fs::path(record.resolvedPath));
+  } catch (...) {
+  }
+}
+
+void observeFileBytes(const std::string& path, DependencyKind kind,
+                      const std::string& bytes)
+{
+  if (path.empty()) return;
+  try {
+    const std::lock_guard<std::mutex> lock(dependenciesMutex);
+    if (!enabled) return;
+    auto& record = fileRecord(path, kind);
+    if (record.kind.empty()) return;
+    digestBuffer(record, bytes);
+  } catch (...) {
+  }
+}
+
+void observeLookup(const std::string& requestingFile, const std::string& name,
+                   const std::vector<std::string>& candidates, const std::string& winner)
+{
+  try {
+    const std::lock_guard<std::mutex> lock(dependenciesMutex);
+    if (!enabled) return;
+    if (trackedLookups.size() >= maxDependencyLookups || candidates.size() > maxLookupCandidates) {
+      ++droppedLookups;
+      return;
+    }
+    auto& record = trackedLookups.emplace_back();
+    record.requestingPath = boundedPath(requestingFile);
+    record.name = bounded(name, maxNameBytes);
+    for (const auto& candidate : candidates) {
+      record.candidates.push_back(boundedPath(candidate));
+    }
+    record.winner = boundedPath(winner);
+  } catch (...) {
+  }
+}
+
+void observeAsset(const fs::path& requestingFile, const std::string& name,
+                  const std::string& resolved, DependencyKind kind)
+{
+  try {
+    std::string winner;
+    if (!resolved.empty()) {
+      std::error_code error;
+      const fs::path candidate(resolved);
+      if (fs::exists(candidate, error) && !error && !fs::is_directory(candidate, error) && !error) {
+        winner = resolved;
+      }
+    }
+    observeLookup(requestingFile.empty() ? "" : fs_generic_string(requestingFile), name,
+                  resolved.empty() ? std::vector<std::string>{} : std::vector<std::string>{resolved},
+                  winner);
+    if (!resolved.empty()) observeFile(resolved, kind);
+  } catch (...) {
+  }
+}
+
+json dependencyFiles()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  json files = json::array();
+  for (std::size_t i = 0; i < trackedFiles.size(); ++i) {
+    const auto& record = trackedFiles[i];
+    if (!record.hasBytes || record.sha256.empty()) continue;
+    json file{{"id", i + 1},
+              {"logicalPath", record.logicalPath},
+              {"kind", record.kind},
+              {"writable", false}};
+    if (!record.resolvedPath.empty()) file["resolvedPath"] = record.resolvedPath;
+    if (!record.sha256.empty()) file["sha256"] = record.sha256;
+    if (record.hasBytes) file["byteLength"] = record.byteLength;
+    files.push_back(std::move(file));
+  }
+  return files;
+}
+
+json dependencyLookups()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  json lookups = json::array();
+  for (const auto& record : trackedLookups) {
+    json lookup{{"name", record.name}, {"candidates", record.candidates}};
+    if (!record.requestingPath.empty()) {
+      lookup["requestingPath"] = record.requestingPath;
+      if (const auto index = lookupFileIndex(record.requestingPath);
+          index != npos && trackedFiles[index].hasBytes && !trackedFiles[index].sha256.empty()) {
+        lookup["requestingFileID"] = index + 1;
+      }
+    }
+    if (!record.winner.empty() && !record.candidates.empty()) {
+      lookup["winner"] = record.candidates.back();
+      std::error_code error;
+      const auto canonical = fs::canonical(fs::path(record.winner), error);
+      if (!error) lookup["resolvedWinner"] = fs_generic_string(canonical);
+    }
+    lookups.push_back(std::move(lookup));
+  }
+  return lookups;
+}
+
+json dependencySpan(const Location& location)
+{
+  try {
+    const std::lock_guard<std::mutex> lock(dependenciesMutex);
+    if (location.isNone()) return nullptr;
+    const auto index = lookupFileIndex(location.filePath().generic_string());
+    if (index == npos) return nullptr;
+    const auto& record = trackedFiles[index];
+    if (record.lineStarts.empty() || !record.hasBytes) return nullptr;
+    json span = offsets(record, location);
+    if (span.is_null()) return nullptr;
+    span["fileID"] = index + 1;
+    return span;
+  } catch (...) {
+    return nullptr;
+  }
+}
+
+json dependencyOverflow()
+{
+  const std::lock_guard<std::mutex> lock(dependenciesMutex);
+  return {{"droppedFiles", droppedFiles}, {"droppedLookups", droppedLookups}};
+}
+
+void FontcacheLock::release()
+{
+#ifndef _WIN32
+  if (fd_ >= 0) {
+    ::flock(fd_, LOCK_UN);
+    ::close(fd_);
+    fd_ = -1;
+  }
+#endif
+}
+
+FontcacheLock lockFontcacheInit()
+{
+#ifdef _WIN32
+  return {};
+#else
+  try {
+    if (!dependenciesEnabled()) return {};
+    const auto cache = std::getenv("XDG_CACHE_HOME");
+    if (!cache || !*cache) return {};
+    const fs::path path = fs::path(cache) / "scadretto-fontconfig-v1.lock";
+    const int fd = ::open(path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return {};
+    if (::flock(fd, LOCK_EX) != 0) {
+      ::close(fd);
+      return {};
+    }
+    return FontcacheLock(fd);
+  } catch (...) {
+    return {};
+  }
+#endif
+}
+
+}  // namespace scadretto
diff --git a/src/core/ScadrettoDependencies.h b/src/core/ScadrettoDependencies.h
new file mode 100644
index 0000000..2a8a042
--- /dev/null
+++ b/src/core/ScadrettoDependencies.h
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "core/AST.h"
+#include "ext/json/json.hpp"
+
+// Dependency observation for the Scadretto worker (protocol v1).
+//
+// The worker calls scadretto::beginDependencies() before evaluating a job and
+// splices dependencyFiles()/dependencyLookups() into result.json afterwards.
+// Each worker process runs one job and has one recording session.
+// Every observe*() function is a no-op while recording is disabled, never
+// throws, and never changes upstream behavior: hook sites only read values
+// upstream already computed.
+namespace scadretto {
+
+enum class DependencyKind { Main, Include, Use, Import, Surface, Dxf, Font };
+
+void beginDependencies();
+void endDependencies();
+bool dependenciesEnabled();
+
+// Records one consumed (or attempted, when unresolved) file. path is the
+// absolute path upstream resolved or tried; when the file is readable its raw
+// bytes - BOM included - are streamed for the digest and the span index.
+// Repeated calls for the same file update the first record; the first kind
+// wins.
+void observeFile(const std::string& path, DependencyKind kind);
+
+// Same as observeFile, using the byte buffer upstream already holds instead of
+// re-reading the file. bytes are the raw consumed file bytes before any lexer
+// adaptation (no appended parser suffix).
+void observeFileBytes(const std::string& path, DependencyKind kind,
+                      const std::string& bytes);
+
+// Records one ordered lookup: the file containing the reference (empty when
+// unknown), the name as written, every absolute candidate probed up to and
+// including the winner, and the winning path or empty when nothing resolved.
+void observeLookup(const std::string& requestingFile, const std::string& name,
+                   const std::vector<std::string>& candidates, const std::string& winner);
+
+// Convenience for the lookup_file() call sites (import, surface, dxf, json
+// import): records a single-candidate lookup for the resolved absolute path -
+// winner only when it exists and is not a directory - then observes the file
+// itself, including a record for the unresolved path when one is known.
+void observeAsset(const fs::path& requestingFile, const std::string& name,
+                  const std::string& resolved, DependencyKind kind);
+
+// Protocol v1 "files" records; ids start at 1 (0 is the main file).
+nlohmann::json dependencyFiles();
+
+// Protocol v1 "lookups" records in observation order. requestingFileID is set
+// only when the requesting file is itself a tracked dependency; requestingPath
+// always carries the requesting file so the caller can map it.
+nlohmann::json dependencyLookups();
+
+// {fileID, start, end} byte span in the original file bytes (BOM included),
+// or null when the location is untracked, unindexed or out of range.
+nlohmann::json dependencySpan(const Location& location);
+
+// {"droppedFiles", "droppedLookups"} counts of records skipped by the bounds.
+nlohmann::json dependencyOverflow();
+
+// RAII guard serializing fontconfig/freetype initialization across concurrent
+// v1 workers. FontCache::FontCache takes it for the duration of its
+// constructor; because the cache is created lazily, jobs without text() never
+// wait on it. Holds no descriptor (and does nothing) while recording is
+// disabled or on platforms without flock().
+class FontcacheLock {
+public:
+  FontcacheLock() = default;
+  explicit FontcacheLock(int fd) : fd_(fd) {}
+  FontcacheLock(const FontcacheLock&) = delete;
