+void scadrettoMark(Value& value, const std::string& kind, const std::string& name,
+                   const Location& location)
+{
+  if (!traceEnabled || value.type() != Value::Type::NUMBER) return;
+  value.scadrettoBinding = std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{kind, name, location, value.scadrettoBinding});
+}
+
+void scadrettoRecordIteration(AbstractNode& loop, std::size_t firstChild,
+                              const std::vector<std::shared_ptr<Assignment>>& arguments,
+                              const std::shared_ptr<const Context>& iterationContext)
+{
+  if (!traceEnabled || firstChild == loop.children.size()) return;
+  std::map<std::string, double> bindings;
+  for (const auto& arg : arguments) {
+    const auto& name = arg->getName();
+    const auto& value = iterationContext->lookup_variable(name, arg->location());
+    if (value.type() == Value::Type::NUMBER) bindings[name] = value.toDouble();
+  }
+  for (auto i = firstChild; i < loop.children.size(); ++i) {
+    loop.children[i]->scadrettoIteration = bindings;
+  }
+}
+
+int scadrettoRunJob(const std::string& requestPath)
+{
+  const auto directory = fs::absolute(requestPath).parent_path();
+  json request;
+  try {
+    request = json::parse(readFile(requestPath, maxRequestBytes));
+  } catch (const std::exception&) {
+    // The M0 branch below re-reads the request and reports the same error.
+    request = json();
+  }
+  if (request.is_object() && request.contains("protocolVersion")) {
+    return runJobV1(request, directory);
+  }
+  return runJobM0(requestPath, directory);
+}
