@@ -791,10 +860,156 @@ int runJobM0(const std::string& requestPath, const fs::path& directory)
 }  // namespace
 
+bool scadrettoTracing()
+{
+  return traceEnabled;
+}
+
+ScadrettoNodeTrace& scadrettoDetails(AbstractNode& node)
+{
+  if (!node.scadrettoDetails) node.scadrettoDetails = std::make_shared<ScadrettoNodeTrace>();
+  return *node.scadrettoDetails;
+}
+
+void scadrettoProperty(ScadrettoNodeTrace& trace, const char *semantic, const std::string& formal,
+                       double value, const Value *authored, double displayMultiplier,
+                       bool centered, const char *status)
+{
+  if (!std::isfinite(value) || trace.properties.size() >= 64) return;
+  const auto binding = authored ? authored->scadrettoBinding : nullptr;
+  const auto expression = binding ? binding->location : Location::NONE;
+  trace.properties.push_back({semantic, formal, status, value, displayMultiplier, centered,
+                              expression, binding, std::nullopt, false});
+}
+
+void scadrettoProperty(AbstractNode& node, const char *semantic, const std::string& formal,
+                       double value, const Value *authored, double displayMultiplier,
+                       bool centered, const char *status)
+{
+  if (!traceEnabled) return;
+  scadrettoProperty(scadrettoDetails(node), semantic, formal, value, authored, displayMultiplier,
+                    centered, status);
+}
+
+static bool directVector(const Value& value)
+{
+  const auto root = value.scadrettoBinding;
+  // A direct vector argument starts at the bound formal and argument, with no intervening lookup.
+  const auto argument = root && root->kind == "parameter" ? root->previous : nullptr;
+  const auto vector = argument && argument->kind == "argument" ? argument->previous : nullptr;
+  return value.type() == Value::Type::VECTOR && vector && vector->kind == "vector";
+}
+
+void scadrettoVectorProperties(AbstractNode& node, const std::string& formal,
+                              const Value& value, const std::vector<double>& evaluated,
+                              const std::vector<const char *>& semantics, bool centered)
+{
+  if (!traceEnabled) return;
+  const auto direct = directVector(value);
+  const auto count = value.type() == Value::Type::VECTOR ? value.toVector().size() : 0;
+  for (std::size_t index = 0; index < evaluated.size(); ++index) {
+    const Value *element = direct && index < count ? &value.toVector()[index] : nullptr;
+    const char *status = index >= count ? "default" : element ? "bound" : "computedVector";
+    scadrettoProperty(node, semantics[index], formal, evaluated[index], element, 1, centered, status);
+  }
+}
+
+void scadrettoIgnoreArgument(AbstractNode& node, const std::string& formal)
+{
+  if (!node.scadrettoDetails) return;
+  for (auto& argument : node.scadrettoDetails->arguments) {
+    if (argument.formal == formal && argument.status == "bound") argument.status = "ignored";
+  }
+}
+
 void scadrettoMark(Value& value, const std::string& kind, const std::string& name,
                    const Location& location)
 {
-  if (!traceEnabled || value.type() != Value::Type::NUMBER) return;
+  if (!traceEnabled || (value.type() != Value::Type::NUMBER && value.type() != Value::Type::VECTOR)) return;
+  value.scadrettoBinding = std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{kind, name, location, value.scadrettoBinding, nullptr, nullptr,
+                     value.type() == Value::Type::NUMBER ? value.toDouble() : 0});
+}
+
+void scadrettoMarkArithmetic(Value& result, const char *operation, const Location& location,
+                             const Value& left, const Value& right)
+{
+  if (!traceEnabled || result.type() != Value::Type::NUMBER ||
+      left.type() != Value::Type::NUMBER || right.type() != Value::Type::NUMBER) return;
+  result.scadrettoBinding = std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{operation, "", location, left.scadrettoBinding, right.scadrettoBinding,
+                     nullptr, result.toDouble()});
+}
+
+void scadrettoMarkRange(Value& result, const Location& location, const Value& begin, const Value& end,
+                        const std::shared_ptr<const ScadrettoBinding>& step, bool explicitStep)
+{
+  if (!traceEnabled) return;
+  result.scadrettoBinding = std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{explicitStep ? "rangeWithStep" : "range", "", location, begin.scadrettoBinding,
+                     end.scadrettoBinding, step});
+}
+
+void scadrettoMarkIteration(Value& value, const std::string& name, const Location& location,
+                            const Value& range)
+{
+  if (!traceEnabled) return;
   value.scadrettoBinding = std::make_shared<ScadrettoBinding>(
-    ScadrettoBinding{kind, name, location, value.scadrettoBinding});
+    ScadrettoBinding{"iteration", name, location, range.scadrettoBinding, nullptr, nullptr,
+                     value.toDouble()});
+}
+
+static bool sameLocation(const Location& left, const Location& right)
+{
+  return left.filePath() == right.filePath() && left.firstLine() == right.firstLine() &&
+         left.firstColumn() == right.firstColumn() && left.lastLine() == right.lastLine() &&
+         left.lastColumn() == right.lastColumn();
+}
+
+static bool independentOf(const ScadrettoBinding *binding, const Location& target, unsigned depth = 0)
+{
+  if (!binding || depth > 64 || sameLocation(binding->location, target)) return false;
+  const auto& kind = binding->kind;
+  if (kind == "literal") return std::isfinite(binding->value);
+  if (kind == "lookup" || kind == "assignment" || kind == "parameter" ||
+      kind == "argument" || kind == "default" || kind == "element") {
+    return independentOf(binding->previous.get(), target, depth + 1);
+  }
+  if (kind == "add" || kind == "multiply" || kind == "subtract" ||
+      kind == "range" || kind == "rangeWithStep") {
+    return independentOf(binding->previous.get(), target, depth + 1) &&
+           independentOf(binding->second.get(), target, depth + 1) &&
+           (kind != "rangeWithStep" || independentOf(binding->third.get(), target, depth + 1));
+  }
+  return false;
+}
+
+void scadrettoPitch(AbstractNode& node, const Value& vector)
+{
+  if (!traceEnabled || !directVector(vector) || vector.toVector().size() < 2) return;
+  const auto& values = vector.toVector();
+  const auto component = values[0].scadrettoBinding;
+  const auto sum = component && component->kind == "element" ? component->previous : nullptr;
+  if (!sum || sum->kind != "add" || !sameLocation(sum->location, component->location)) return;
+  const auto base = sum->previous;
+  const auto product = sum->second;
+  if (!base || base->kind != "lookup" || !product || product->kind != "multiply") return;
+  const auto iteration = product->previous;
+  const auto pitch = product->second;
+  if (!iteration || iteration->kind != "lookup" || !iteration->previous ||
+      iteration->previous->kind != "iteration" || !pitch || pitch->kind != "lookup") return;
+  const auto declaration = pitch->previous;
+  if (!declaration || declaration->kind != "assignment" || !declaration->previous ||
+      declaration->previous->kind != "literal" || !std::isfinite(pitch->value) ||
+      !std::isfinite(iteration->value)) return;
+
+  const auto& target = declaration->previous->location;
+  auto independent = independentOf(base.get(), target) &&
+    independentOf(iteration->previous->previous.get(), target);
+  for (std::size_t index = 1; index < values.size(); ++index) {
+    independent = independent && independentOf(values[index].scadrettoBinding.get(), target);
