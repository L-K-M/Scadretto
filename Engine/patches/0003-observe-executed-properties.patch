+  const auto product = sum->second;
+  if (!base || base->kind != "lookup" || !product || product->kind != "multiply") return;
+  const auto iteration = product->previous;
+  const auto pitch = product->second;
+  if (!iteration || iteration->kind != "lookup" || !iteration->previous ||
+      iteration->previous->kind != "iteration" || !pitch || pitch->kind != "lookup") return;
+  const auto declaration = pitch->previous;
+  if (!declaration || declaration->kind != "assignment" || !declaration->previous ||
+      declaration->previous->kind != "literal" || !std::isfinite(pitch->value) ||
+      !std::isfinite(iteration->value)) return;
