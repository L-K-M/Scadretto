+// Follows literals through the operations the trace observes. A read that no
+// property explains leaves that literal's impact set partial.
+class ImpactTrace
+{
+public:
+  const ScadrettoOrigins *literal(const Location& location)
+  {
+    if (auto found = byAddress.find(&location); found != byAddress.end()) return found->second;
+    // Including a file twice creates two syntax nodes for the same bytes.
+    const auto key = std::make_tuple(location.fileName(), location.firstLine(), location.firstColumn(),
+                                     location.lastLine(), location.lastColumn());
+    const auto *canonical = bySource.emplace(key, &location).first->second;
+    const auto *origins = &*interned.insert(ScadrettoOrigins{canonical}).first;
+    byAddress.emplace(&location, origins);
+    return origins;
+  }
+
+  const ScadrettoOrigins *merge(const ScadrettoOrigins *left, const ScadrettoOrigins *right)
+  {
+    if (!left || left == right) return right;
+    if (!right) return left;
+    const auto pair = std::minmax(left, right);
+    if (auto found = merged.find(pair); found != merged.end()) return found->second;
+    ScadrettoOrigins joined;
+    std::set_union(left->begin(), left->end(), right->begin(), right->end(), std::back_inserter(joined),
+                   std::less<const Location *>());
+    const ScadrettoOrigins *result = nullptr;
+    if (joined.size() <= maxOrigins) {
+      result = &*interned.insert(std::move(joined)).first;
+    } else {
+      partial.insert(joined.begin(), joined.end());
+    }
+    merged.emplace(pair, result);
+    return result;
+  }
+
+  void read(const Location& site, const ScadrettoOrigins *origins)
+  {
+    if (origins) reads.emplace(&site, origins);
+  }
+
+  // Built-ins also read special variables without evaluating a lookup.
+  void implicitlyRead(const ScadrettoOrigins *origins)
+  {
+    if (origins) partial.insert(origins->begin(), origins->end());
+  }
+
+  std::unordered_set<const Location *> untraced(const std::unordered_set<const Location *>& explained) const
+  {
+    auto result = partial;
+    for (const auto& [site, origins] : reads) {
+      if (!explained.count(site)) result.insert(origins->begin(), origins->end());
+    }
+    return result;
+  }
+
+private:
+  std::set<ScadrettoOrigins> interned;
+  std::map<std::tuple<std::string, int, int, int, int>, const Location *> bySource;
+  std::unordered_map<const Location *, const ScadrettoOrigins *> byAddress;
+  std::map<std::pair<const ScadrettoOrigins *, const ScadrettoOrigins *>, const ScadrettoOrigins *> merged;
+  std::set<std::pair<const Location *, const ScadrettoOrigins *>> reads;
+  std::unordered_set<const Location *> partial;
+};
+
+ImpactTrace impact;
+
+using BindingRef = std::shared_ptr<const ScadrettoBinding>;
+
+BindingRef makeBinding(std::string kind, const std::string& name, const Location& location, double value,
+                       BindingRef previous, BindingRef second = nullptr, BindingRef third = nullptr)
+{
+  unsigned depth = 1;
+  const ScadrettoOrigins *origins = nullptr;
+  for (const auto *input : {&previous, &second, &third}) {
+    if (!*input) continue;
+    depth = std::max(depth, (*input)->depth + 1);
+    origins = impact.merge(origins, (*input)->origins);
+  }
+  const Location *site = nullptr;
+  if (kind == "literal") {
+    // Built-in defaults such as $fn have no bytes to edit, so they are no origin.
+    if (!location.isNone()) origins = impact.literal(location);
+  } else if (kind == "lookup") {
+    site = &location;
+    impact.read(location, origins);
+  }
+  if (!name.empty() && name.front() == '$') impact.implicitlyRead(origins);
+  if (depth > maxBindingDepth) {
+    kind = "truncated";
+    previous = second = third = nullptr;
+    depth = 1;
+  }
+  return std::make_shared<ScadrettoBinding>(
+    ScadrettoBinding{std::move(kind), name, location, std::move(previous), std::move(second),
+                     std::move(third), value, origins, site, depth});
+}
+
+// Computed results can fill large lists, so equal origins share one node.
+BindingRef computedBinding(const ScadrettoOrigins *origins)
+{
+  static std::unordered_map<const ScadrettoOrigins *, BindingRef> shared;
+  auto& binding = shared[origins];
+  if (!binding) {
+    binding = std::make_shared<ScadrettoBinding>(
+      ScadrettoBinding{"computed", "", Location::NONE, nullptr, nullptr, nullptr, 0, origins, nullptr, 1});
+  }
+  return binding;
+}
+
+bool directLink(const std::string& kind)
+{
+  return kind == "parameter" || kind == "argument" || kind == "assignment" || kind == "lookup" ||
+         kind == "element" || kind == "default";
+}
+
+// The literal that an edit of this binding would replace.
+const Location *writableLiteral(const ScadrettoBinding *binding)
+{
+  while (binding && directLink(binding->kind)) binding = binding->previous.get();
+  if (!binding || binding->kind != "literal" || !binding->origins) return nullptr;
+  return binding->origins->front();
+}
+
+bool consumes(const ScadrettoProperty& property, const Location *literal)
+{
+  if (property.semantic == "moduleArgument" || property.status == "invalid" || !property.binding) return false;
+  const auto *origins = property.binding->origins;
+  return origins && std::find(origins->begin(), origins->end(), literal) != origins->end();
+}
