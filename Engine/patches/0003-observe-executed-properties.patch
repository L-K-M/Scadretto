+  void addPropertyEdges(const ScadrettoProperty& property, const AbstractNode& node)
+  {
+    std::vector<const ScadrettoBinding *> pending{property.binding.get()};
+    unsigned remaining = 128;
+    while (!pending.empty() && remaining > 0) {
+      const auto *binding = pending.back();
+      pending.pop_back();
+      if (!binding) continue;
+      --remaining;
+      const auto bindingSpan = span(binding->location);
+      if (!bindingSpan.is_null()) {
+        dependencyEdges.push_back({{"span", bindingSpan}, {"instanceID", node.index()},
+                                   {"property", property.semantic}});
+      }
+      pending.push_back(binding->previous.get());
+      pending.push_back(binding->second.get());
+      pending.push_back(binding->third.get());
+    }
+  }
+
+  void addProperties(json& instance, const AbstractNode& node, bool stableFrame, unsigned loops)
+  {
+    if (!v1() || !node.scadrettoDetails) return;
+    const auto& detail = *node.scadrettoDetails;
+    instance["definitionSpan"] = span(detail.definition);
+    auto arguments = json::array();
+    for (const auto& argument : detail.arguments) {
+      arguments.push_back({{"name", argument.name}, {"formal", argument.formal},
+                           {"status", argument.status}, {"expression", span(argument.expression)}});
+    }
+    instance["arguments"] = std::move(arguments);
+    auto properties = json::array();
+    for (const auto& property : detail.properties) {
+      auto chain = json::array();
+      for (auto binding = property.binding; binding; binding = binding->previous) {
+        const auto bindingSpan = span(binding->location);
+        chain.push_back({{"kind", binding->kind}, {"name", binding->name}, {"span", bindingSpan}});
+        if (branching(*binding)) break;
+      }
+      addPropertyEdges(property, node);
+      properties.push_back({{"semantic", property.semantic}, {"formal", property.formal},
+                            {"status", property.status}, {"value", property.value},
+                            {"displayMultiplier", property.displayMultiplier},
+                            {"centered", property.centered}, {"expression", span(property.expression)},
+                            {"chain", std::move(chain)}});
+      if (property.iteration) {
+        properties.back()["pitch"] = {{"iteration", *property.iteration},
+                                      {"dragVerified", stableFrame && loops == 1 &&
+                                                        property.pitchIndependent}};
+      }
+    }
+    instance["properties"] = std::move(properties);
+  }
