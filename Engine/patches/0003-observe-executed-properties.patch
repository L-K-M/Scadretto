+// Releasing a chain recurses once per link, so its depth has to stay bounded.
+constexpr unsigned maxBindingDepth = 4096;
+constexpr std::size_t maxChainLinks = 256;
+constexpr std::size_t maxOrigins = 32;
 constexpr uint32_t meshPayloadVersion = 1;
